{
  "name": "angular-portfolio-2025",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev": "npm run start",
    "dev:api": "node backend/server.js",
    "seed:neon": "node scripts/seed-neon.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:demo": "node scripts/seed-demo-neon.js",
    "clear:demo": "node scripts/clear-demo.js",
    "hash-password": "node scripts/hash-password.js",
    "lint": "ng lint",
    "preview": "ng serve --prod",
    "test:ci": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "test:coverage": "ng test --code-coverage",
    "test:backend-security": "node --test backend/security.test.js backend/mfa.test.js backend/cv.test.js backend/contact-mail.test.js backend/admin-account.test.js",
    "postinstall": "node scripts/fix-angular-dts.js"
  },
  "lint-staged": {
    "*.{js,ts,html,css,scss,json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "overrides": {
    "body-parser": "2.4.0",
    "ip-address": "10.7.5",
    "lodash-es": "4.18.1",
    "path-to-regexp": "8.4.2",
    "proxy-addr": "2.0.8"
  },
  "dependencies": {
    "@angular/animations": "20.3.34",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.34",
    "@angular/platform-browser-dynamic": "20.3.34",
    "@angular/router": "20.3.34",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.1.2",
    "@neondatabase/serverless": "^1.0.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@types/pg": "^8.23.1",
    "@vercel/blob": "^2.8.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "otpauth": "^9.5.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "resend": "^6.34.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.34",
    "@angular/cli": "20.3.34",
    "@angular/compiler-cli": "20.3.34",
    "@playwright/test": "^1.55.1",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.11.33",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.2"
  }
}

# Copy this file to .env.local (or .env) and fill in real values.
# Never commit real credentials.

# Neon PostgreSQL (required) — one URL only.
# Neon shows pooled and direct (unpooled). Use the pooled URI (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Admin credentials
ADMIN_EMAIL=support@bluepeacktechnologies.com

# Production: bcrypt hash from `npm run hash-password -- "your-password"`
# Seeded accounts should use ADMIN_PASSWORD_HASH, not ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH

# Development only (never use in production)
# ADMIN_PASSWORD

# Auth token signing secret (min 32 chars in production)
# JWT_SECRET

# Comma-separated allowed frontend origins for CORS (no trailing slash)
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://your-domain.vercel.app

# WebAuthn / passkeys (hostname only for RP ID, full origin for expected origin)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:4200
WEBAUTHN_RP_NAME=BluePeack Technologies

# Optional
PORT=3000

# Neon Auth (Managed Better Auth). Admin login still uses cookie sessions.
# NEON_AUTH_BASE_URL
# NEON_AUTH_JWKS_URL

# Neon Object Storage (S3). neon deploy fills AWS_* keys.
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# AWS_REGION
# AWS_ENDPOINT_URL_S3

# Neon AI Gateway. neon deploy fills NEON_AI_GATEWAY_*.
# NEON_AI_GATEWAY_TOKEN
# NEON_AI_GATEWAY_BASE_URL
# CV import: put the full OpenAI key in .env.local (not this file), then restart `npm run dev:api`.
# Project keys start with sk-proj- and are long; a truncated value is rejected.
# OPENAI_API_KEY
# AI_GATEWAY_API_KEY
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# Neon Realtime (server-only secret)
# NEON_REALTIME_URL
# NEON_REALTIME_SECRET

# Contact form email notify (optional). Form still saves to Admin → Messages if unset.
# RESEND_API_KEY
CONTACT_FROM_EMAIL=hello@your-verified-domain.com
# CONTACT_TO_EMAIL=you@example.com
